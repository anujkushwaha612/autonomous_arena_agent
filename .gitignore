node_modules/
.arena-profile/
app/node_modules/

# runtime state — the data dir is tracked via .gitkeep, its contents are not
app/data/*.json
app/data/*.json.tmp
!app/data/.gitkeep

# runtime patch drops (raw agent payloads) — never commit
fastcapture/drops/*
!fastcapture/drops/.gitkeep

# transient
.drop-*.patch
.drop-*.bundle
*.log
.DS_Store
package-lock.json
app/package-lock.json
.bin
# transient patch files applied by the worker
.drop-*
run.log.jsonl
.env
data/
