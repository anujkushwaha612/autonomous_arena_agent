{
  "name": "impostor",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "ws": "^8.16.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0",
    "tsx": "^4.7.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "esbuild src/client/main.ts --bundle --outfile=public/bundle.js --sourcemap --minify",
    "start": "npm run build && node --import tsx src/server/index.ts",
    "typecheck": "tsc --noEmit"
  }
}
